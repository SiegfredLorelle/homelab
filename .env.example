# Copy to .env, fill in the values, then: chmod 600 .env
# .env is gitignored. Real values live in the password manager.

# Pi-hole web admin password (password manager: "Pi-hole admin")
PIHOLE_PASSWORD=

# Cloudflare API token for Caddy's DNS challenge — Zone:DNS:Edit + Zone:Zone:Read on sieg.dev only
# (password manager: "Cloudflare API token (Caddy DNS)")
CLOUDFLARE_API_TOKEN=

# Pi-hole app password for Homepage's Pi-hole widget
# (password manager: "Pi-hole app password (Homepage)")
HOMEPAGE_VAR_PIHOLE_KEY=
