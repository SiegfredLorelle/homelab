# App data belongs in backups, not git
*/data/

# Secrets
.env
*.json
*.pem

# Website has its own repo
sites/*
!sites/README.md

# Caddy's autosaved runtime config (its certificates live in caddy/data/, covered by */data/ above)
caddy/config/

# Homepage writes logs into its config folder
homepage/config/logs/


# Renovate's config is JSON but not a secret (the *.json rule above is for credentials)
!renovate.json
