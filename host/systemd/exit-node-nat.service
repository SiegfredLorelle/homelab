[Unit]
Description=NAT for Tailscale exit node: masquerade only tailnet traffic leaving via Wi-Fi
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# -C checks whether the rule already exists, so it's never added twice
ExecStart=/bin/sh -c '/usr/sbin/iptables -t nat -C POSTROUTING -s 100.64.0.0/10 -o wlp58s0 -j MASQUERADE 2>/dev/null || /usr/sbin/iptables -t nat -A POSTROUTING -s 100.64.0.0/10 -o wlp58s0 -j MASQUERADE'
ExecStop=/bin/sh -c '/usr/sbin/iptables -t nat -D POSTROUTING -s 100.64.0.0/10 -o wlp58s0 -j MASQUERADE 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
